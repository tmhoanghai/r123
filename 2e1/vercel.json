{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__vpath=$1"
    },
    {
      "source": "/((?!api/|assets/|asset/).*)",
      "destination": "/index.html"
    }
  ]
}
